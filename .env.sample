# =============================================================================
# OMAI+ environment variables
# =============================================================================
#
# How to use this file
#   1. Copy it to `.env` in the repository root:   cp .env.sample .env
#      packages/opencode/.env and packages/app/.env are symlinks to that file,
#      so the server and the web app read the same values.
#   2. Fill in every variable marked [required].
#   3. Restart the server after any change: Bun reads .env only at startup.
#
# Labels
#   [required]  needed in every environment, or the server will not start
#   [local]     only for running on your own machine
#   [prod]      only for the deployed control plane (Northflank `controlplane`)
#   [optional]  safe to leave unset; the default is shown
#
# Two ways to run
#   Local development: one server on your machine, one user, projects on
#     your disk, no login screen. Needs the [required] block, plus
#     OPENCODE_AUTH_MODE=local and OPENCODE_STORAGE_MODE=local.
#   Production (central): many users log in; each project runs in its own
#     Northflank MicroVM, and the control plane routes traffic to them.
#     Needs everything marked [required] and [prod].
#
# Never commit a real .env. Secrets accept a `_FILE` variant instead (for
# example OPENCODE_JWT_SECRET_FILE=/run/secrets/jwt) when mounted as files.
#
# Starting it locally
#   terminal 1 (server):  cd packages/opencode && bun run dev -- serve --cors http://localhost:3000
#   terminal 2 (web app): cd packages/app && bun dev        # http://localhost:3000
#   Apply database migrations first (see the Database section).


# -----------------------------------------------------------------------------
# Database (PostgreSQL)  [required]
# -----------------------------------------------------------------------------
# All data lives in PostgreSQL; there is no SQLite fallback.

# Connection the running server uses. Must be a postgres:// or postgresql:// URL.
OPENCODE_DATABASE_URL=postgresql://omai:changeme@localhost:5432/omai

# Connection used only to apply migrations (needs DDL rights, often the owner
# role). Run migrations with:  cd packages/core && bun run migration:apply
OPENCODE_DATABASE_MIGRATOR_URL=postgresql://omai_owner:changeme@localhost:5432/omai

# PostgreSQL schema that holds the OMAI+ tables. Keep "opencode" unless you
# deliberately run several deployments in one database.
OPENCODE_DATABASE_SCHEMA=opencode

# [optional] When set, migrations grant the runtime role access to the schema.
# Use it when OPENCODE_DATABASE_URL logs in as a restricted role.
# OPENCODE_DATABASE_RUNTIME_ROLE=omai_runtime

# [optional] Connections in the server's pool (2-100, default 10) and connect
# timeout in seconds (1-300, default 30).
# OPENCODE_DATABASE_POOL_SIZE=10
# OPENCODE_DATABASE_CONNECT_TIMEOUT=30


# -----------------------------------------------------------------------------
# Instance identity and encryption  [required]
# -----------------------------------------------------------------------------

# Names this deployment inside the database. Migrations and the server must use
# the same value. Pick one and never change it: data is tied to it.
OPENCODE_INSTANCE_ID=omai_local

# Encrypts provider credentials and other secrets before they are stored.
# Must be exactly 32 random bytes, base64-encoded. Generate one with:
#   openssl rand -base64 32
# Losing or changing it makes already-stored secrets unreadable.
OPENCODE_DATA_KEY=changeme_base64_32_bytes


# -----------------------------------------------------------------------------
# Login and users
# -----------------------------------------------------------------------------

# "local": no login, a single user; only for a server bound to your own machine.
# "central": accounts, login and per-user data; used in production.
# If unset, the mode is "central" whenever OPENCODE_DATABASE_URL is set, so set
# it to "local" explicitly for local development.
OPENCODE_AUTH_MODE=local

# Public address users open in the browser. An origin only (no path). [prod]
# Required in central mode; it is also used for login redirects and links.
# Local example: http://localhost:3000
OPENCODE_PUBLIC_URL=http://localhost:3000

# [prod] Signs login sessions. At least 32 bytes; generate with:
#   openssl rand -base64 48
# Changing it signs everyone out. MicroVMs receive the same value.
# OPENCODE_JWT_SECRET=changeme_at_least_32_bytes

# [prod] Invitation code needed to create an account (at least 32 characters).
# Without it, sign-up is closed in central mode.
# OPENCODE_REGISTRATION_SECRET=changeme_at_least_32_characters

# [prod, optional] "Sign in with Google". Create an OAuth client in Google
# Cloud and add <OPENCODE_PUBLIC_URL>/auth/google/callback as a redirect URI.
# OPENCODE_GOOGLE_CLIENT_ID=changeme.apps.googleusercontent.com
# OPENCODE_GOOGLE_CLIENT_SECRET=changeme

# [prod, optional] Comma-separated usernames that are always admins.
# OPENCODE_ADMIN_USERNAME=alice,bob


# -----------------------------------------------------------------------------
# Server and network
# -----------------------------------------------------------------------------

# Port the OMAI+ server listens on.
OPENCODE_SERVER_PORT=4096

# Hostname used in links to running preview dev servers. Local: localhost.
# Production: the app's public hostname, e.g. web.example.com.
OPENCODE_HOST=localhost

# [optional] Where the server fetches the web UI from when it is not built in.
# Locally this is the Vite dev server.
# OPENCODE_UI_UPSTREAM=http://localhost:3000

# [optional] Basic-auth credentials for the server's API (machine clients and
# MicroVMs). In production this must equal NORTHFLANK_VM_PASSWORD.
# OPENCODE_SERVER_USERNAME=omai
# OPENCODE_SERVER_PASSWORD=changeme

# [optional] Handed to MicroVMs as is; leave the defaults.
# OPENCODE_FRONTEND_PORT=80
# OPENCODE_SERVER_PROTOCOL=http

# [optional] Log level: DEBUG, INFO, WARN or ERROR.
# OPENCODE_LOG_LEVEL=INFO

# [prod] Set on the production control plane. NODE_ENV=production puts
# libraries in production mode. OPENCODE_DOCKER=1 says the server runs in a
# container; in local auth mode, preview dev servers then listen on 0.0.0.0.
# NODE_ENV=production
# OPENCODE_DOCKER=1


# -----------------------------------------------------------------------------
# Web app (Vite, packages/app)
# -----------------------------------------------------------------------------
# Read when the web app is started or built. Restart `bun dev` after changes.

# [local] Where the dev web app finds the server.
VITE_OPENCODE_SERVER_HOST=localhost
VITE_OPENCODE_SERVER_PORT=4096

# [optional] "true": the app refuses to run against a server that is not in
# central (login) mode. Useful for production builds.
# VITE_OPENCODE_CENTRAL=true

# [optional] Release channel shown in the app ("prod" hides dev-only options).
# VITE_OPENCODE_CHANNEL=prod

# [optional] Browser error reporting with Sentry.
# VITE_SENTRY_DSN=https://changeme@o0.ingest.sentry.io/0
# VITE_SENTRY_ENVIRONMENT=production
# VITE_SENTRY_RELEASE=
# [optional, CI] Uploads source maps when building the app.
# SENTRY_AUTH_TOKEN=changeme
# SENTRY_ORG=changeme
# SENTRY_PROJECT=changeme


# -----------------------------------------------------------------------------
# Project storage
# -----------------------------------------------------------------------------

# "local": projects live on this machine's disk. Use for local development.
# "central": projects live on a shared volume; requires OPENCODE_AUTH_MODE=central.
OPENCODE_STORAGE_MODE=local

# [prod] With central storage: the shared volume's mount path, the volume's ID
# (stored in <root>/.opencode-volume.json) and a temp folder on that volume.
# OPENCODE_STORAGE_ROOT=/mnt/omai-central
# OPENCODE_STORAGE_ID=omai_northflank_central
# TMPDIR=/mnt/omai-central/tmp


# -----------------------------------------------------------------------------
# Chat attachments (images, videos, PDFs)  [optional]
# -----------------------------------------------------------------------------
# Uploaded files go to a public bucket and only the URL is stored. Unset: files
# stay inline in the database.

# "gcs" (Google Cloud Storage, default) or "s3" (any S3-compatible service,
# e.g. Cloudflare R2). GCS signs in with Application Default Credentials
# (`gcloud auth application-default login` locally).
# OPENCODE_STORAGE_ADAPTER=gcs
# OPENCODE_STORAGE_BUCKET=your-public-bucket
# Only for "s3":
# OPENCODE_STORAGE_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# OPENCODE_STORAGE_REGION=auto
# OPENCODE_STORAGE_ACCESS_KEY_ID=changeme
# OPENCODE_STORAGE_SECRET_ACCESS_KEY=changeme


# -----------------------------------------------------------------------------
# App previews
# -----------------------------------------------------------------------------

# [prod] Required in central mode. Previews are served from their own HTTPS
# origin, which must use a different hostname from OPENCODE_PUBLIC_URL.
# Example: app at https://web.example.com, previews at https://live.example.com.
# OPENCODE_PREVIEW_URL=https://live.example.com

# [prod] Port the preview listener uses (default 4097); route the preview
# domain to it.
# OPENCODE_PREVIEW_PORT=4097

# [prod, optional] "1" lets previews open without logging in (shareable links).
# OPENCODE_PREVIEW_PUBLIC=1


# -----------------------------------------------------------------------------
# Publishing (Cloudflare Workers for Platforms)
# -----------------------------------------------------------------------------
# Needed for the Publish button. Published apps go to <app>.<zone>.
# One-time setup of the dispatch namespace and router:
#   cd packages/opencode && bun run script/publish-platform.ts
# The API token needs Workers Scripts, Workers Routes, Workers KV Storage,
# Account Settings, Zone, DNS, and SSL and Certificates permissions (Edit).
# MicroVMs receive these from the control plane.
# CLOUDFLARE_API_TOKEN=changeme
# CLOUDFLARE_ACCOUNT_ID=changeme
# [optional] Zone for published apps (default omai.ch) and dispatch namespace
# (default omai-apps).
# CLOUDFLARE_PLATFORM_ZONE=omai.ch
# CLOUDFLARE_DISPATCH_NAMESPACE=omai-apps


# -----------------------------------------------------------------------------
# MicroVM workspaces (Northflank)
# -----------------------------------------------------------------------------
# Only for the production control plane; without NORTHFLANK_API_TOKEN, projects
# run in the server process itself. Each project then runs in its own MicroVM,
# paused when idle and resumed when opened.
#
# Careful: Northflank's runtime-environment API replaces the whole variable
# list. Edit variables in the dashboard, or always send the complete list.

# [prod] Turns MicroVMs on.
# NORTHFLANK_API_TOKEN=changeme
# OPENCODE_WORKSPACE_ADAPTER=northflank

# [prod] Northflank project, MicroVM image and plan.
# NORTHFLANK_PROJECT_ID=omai
# NORTHFLANK_IMAGE=jj123dev/microvm
# NORTHFLANK_DEPLOYMENT_PLAN=nf-compute-100-4

# [prod] Password the control plane uses to reach each MicroVM. Must equal
# OPENCODE_SERVER_PASSWORD. NORTHFLANK_VM_USERNAME defaults to
# OPENCODE_SERVER_USERNAME, or "omai".
# NORTHFLANK_VM_PASSWORD=changeme

# [prod] "true" only on the deployed control plane: it pauses idle VMs, keeps
# reserve VMs warm and resumes interrupted jobs. Never set it on a laptop
# that shares the production database, or it will pause VMs other people use.
# OPENCODE_PROVISION_RECONCILE=true

# [prod, optional] Reach VMs at their private project address instead of the
# public internet. Only works when the control plane runs in the same
# Northflank project.
# NORTHFLANK_PRIVATE_NETWORK=true

# [optional] Database URL and pool size MicroVMs use, if they reach the database
# at a different address than the control plane (default: OPENCODE_DATABASE_URL,
# pool 3).
# OPENCODE_VM_DATABASE_URL=postgresql://omai:changeme@db.internal:5432/omai
# OPENCODE_VM_DATABASE_POOL_SIZE=3

# [optional] Opencode config (JSON) written into every VM.
# NORTHFLANK_VM_GLOBAL_CONFIG={"$schema":"https://opencode.ai/config.json"}

# [optional] VM details: disk size (min 6 GB), port, and how VMs are reached.
# NORTHFLANK_VOLUME_SIZE_GB=6
# NORTHFLANK_SERVICE_PORT=4096
# NORTHFLANK_SERVICE_SCHEME=https
# NORTHFLANK_API_BASE=https://api.northflank.com/v1
# OPENCODE_VM_PROJECTS_ROOT=/home/runner

# --- Pausing idle VMs [optional] ---
# A VM with no requests and nothing running for this long is paused (ms).
# OPENCODE_WORKSPACE_IDLE_MS=300000
# How often idle VMs are checked (ms, at least 10).
# OPENCODE_WORKSPACE_SWEEP_MS=5000
# How long opening a paused project waits for its VM to wake (ms).
# NORTHFLANK_WAKE_TIMEOUT_MS=180000
# How long the first request to a new project waits for its VM (ms).
# OPENCODE_WORKSPACE_CREATE_TIMEOUT_MS=5000

# --- Reserve VMs [optional] ---
# Booted, unused VMs kept ready so a new project opens in seconds.
# Reserves per active user, the most across all users, and how long a user can
# be inactive before their reserves are deleted (ms).
# OPENCODE_RESERVE_PER_USER=2
# OPENCODE_RESERVE_MAX=20
# OPENCODE_RESERVE_IDLE_MS=600000
# Wait after a reserve fails before trying again (ms).
# OPENCODE_RESERVE_RETRY_MS=300000

# --- Provisioning timeouts [optional] (ms) ---
# OPENCODE_PROVISION_BOOT_DEADLINE_MS=120000
# OPENCODE_PROVISION_UPLOAD_DEADLINE_MS=1800000
# OPENCODE_PROVISION_RECONCILE_MS=15000
# OPENCODE_PROVISION_FAILED_TTL_MS=3600000
# OPENCODE_PROVISION_WAIT_MS=30000
# OPENCODE_PROVISION_RETRY_MS=30000

# --- Control plane to VM connection [optional] (ms) ---
# OPENCODE_WORKSPACE_CONNECT_TIMEOUT_MS=5000
# OPENCODE_WORKSPACE_HISTORY_TIMEOUT_MS=15000
# OPENCODE_WORKSPACE_STREAM_IDLE_MS=30000
# OPENCODE_WORKSPACE_WAKE_RETRY_MS=1000


# -----------------------------------------------------------------------------
# Extras  [optional]
# -----------------------------------------------------------------------------

# Web search tool: "exa" or "parallel", with that provider's key.
# OPENCODE_WEBSEARCH_PROVIDER=exa
# EXA_API_KEY=changeme
# PARALLEL_API_KEY=changeme

# Token for the `opencode github` CLI command (GitHub Actions integration).
# GITHUB_TOKEN=changeme

# OpenTelemetry tracing (also passed to MicroVMs).
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otel.example.com
# OTEL_EXPORTER_OTLP_HEADERS=authorization=changeme
# OTEL_RESOURCE_ATTRIBUTES=deployment.environment=production

# AI model providers (Anthropic, OpenAI, Bedrock, Vertex, and so on) are set up
# in the app's settings, not here. Their standard variables (ANTHROPIC_API_KEY,
# OPENAI_API_KEY, AWS_PROFILE, ...) also work if you prefer environment variables.
