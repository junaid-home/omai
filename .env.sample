# Server host IP (used for CORS, healthcheck, and frontend backend URL)
OPENCODE_HOST=localhost

# Ports
OPENCODE_SERVER_PORT=4096
OPENCODE_FRONTEND_PORT=80

# Protocol for frontend-to-backend communication.
# Behind a reverse proxy (nginx + Cloudflare), the frontend uses the browser's
# current origin (window.location.origin) so this value is not used at runtime.
# Only set this when the frontend connects to the backend on a different origin.
# OPENCODE_SERVER_PROTOCOL=http

# Object storage for file attachments (images/videos/PDFs).
# File bytes are uploaded to a public GCS bucket and only the URL is stored in
# the database. Auth uses GCP Application Default Credentials (k8s Workload
# Identity / metadata server on GKE; `gcloud auth application-default login`
# locally) - no static access keys are required.
OPENCODE_STORAGE_ADAPTER=gcs
# OPENCODE_STORAGE_BUCKET=your-public-bucket

# CLOUDFLARE_ACCOUNT_ID=changeme
# CLOUDFLARE_API_TOKEN=changeme
# CLOUDFLARE_OMAI_CH_ZONE_ID=changeme