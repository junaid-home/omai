# Stage 1: Build packages/opencode binary from source
FROM oven/bun:1.3.14 AS builder

WORKDIR /app

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 make g++ git ripgrep \
    && rm -rf /var/lib/apt/lists/*

# Copy entire repo
COPY . .

# Remove lockfile and whitelist only packages needed for server build
RUN rm -f bun.lock && \
    bun -e 'var p=JSON.parse(require("fs").readFileSync("package.json","utf8"));p.workspaces.packages=["packages/opencode","packages/app","packages/script","packages/plugin","packages/sdk/js","packages/core","packages/server","packages/protocol","packages/schema","packages/session-ui","packages/llm","packages/codemode","packages/tui","packages/http-recorder","packages/effect-drizzle-sqlite","packages/effect-sqlite-node","packages/ui","packages/northflank"];p.devDependencies={"prettier":"3.6.2"};require("fs").writeFileSync("package.json",JSON.stringify(p,null,2))'

# Install dependencies
RUN bun install --ignore-scripts
RUN bun run --cwd packages/core fix-node-pty

# Init git repo (build script needs git branch info, .git is excluded by .dockerignore)
RUN mkdir -p .github && touch .github/TEAM_MEMBERS && \
    git config --global user.email "info@omai+.ai" && \
    git config --global user.name "OMAI+" && \
    git init && echo "node_modules" > .gitignore && git add -A && git commit -m "init"

# Build the binary (remove prepare scripts so bun add doesn't fail on missing husky)
# MODELS_DEV_API_JSON can be passed as build arg to use a local pre-fetched file
ARG MODELS_DEV_API_JSON=""
RUN bun -e 'var p=JSON.parse(require("fs").readFileSync("package.json","utf8"));delete p.scripts.prepare;require("fs").writeFileSync("package.json",JSON.stringify(p,null,2))' && \
    bun -e 'var p=JSON.parse(require("fs").readFileSync("packages/opencode/package.json","utf8"));delete p.scripts.prepare;require("fs").writeFileSync("packages/opencode/package.json",JSON.stringify(p,null,2))' && \
    MODELS_DEV_API_JSON=${MODELS_DEV_API_JSON} bun run --cwd packages/opencode build -- --single

# Verify and locate binary
RUN BINARY=$(find packages/opencode/dist -name "opencode" -type f | head -1) && \
    $BINARY --version && \
    cp "$BINARY" /usr/local/bin/omai && \
    ln -s omai /usr/local/bin/opencode

# Stage 2: Runtime
FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    git ripgrep curl ca-certificates sudo gnupg chromium \
    && mkdir -p /etc/apt/keyrings \
    && curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg \
    && echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_22.x nodistro main" | tee /etc/apt/sources.list.d/nodesource.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends nodejs \
    && npm install -g pnpm bun lighthouse \
    && rm -rf /var/lib/apt/lists/*

# Lighthouse drives a headless Chromium installed above; the preview audit
# resolves this path through chrome-launcher.
ENV CHROME_PATH=/usr/bin/chromium

# Create runner user with sudo access
RUN useradd -m -s /bin/bash runner && \
    echo "runner ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers.d/runner && \
    chown runner:runner /root

# Copy the built binary
COPY --from=builder /usr/local/bin/omai /usr/local/bin/omai
RUN ln -s omai /usr/local/bin/opencode && omai --version

ARG OPENCODE_HOST
ARG OPENCODE_SERVER_PORT=4096
# Declared because the entrypoint below expands it into a --cors origin. Without
# this ARG the origin bakes as the literal "http://<host>:" rather than failing
# the build, so a missing build-arg is easy to miss. Callers that set
# OPENCODE_HOST at runtime still override it; the ARG is only the fallback.
ARG OPENCODE_FRONTEND_PORT=80
ENV OPENCODE_HOST=${OPENCODE_HOST}
ENV OPENCODE_SERVER_PORT=${OPENCODE_SERVER_PORT}
ENV OPENCODE_FRONTEND_PORT=${OPENCODE_FRONTEND_PORT}

# Create entrypoint script. No sudo: hardened containers (Northflank MicroVMs)
# set no_new_privs, sudo refuses to elevate, and set -e would abort before serve
# ever starts. mkdir works as root and as runner (the paths are under
# runner's home); the chown only matters when root pre-created the tree and is
# skipped silently when unprivileged.
COPY <<'ENTRYPOINT' /usr/local/bin/entrypoint.sh
#!/bin/sh
set -e
mkdir -p /home/runner/.local/share/opencode /home/runner/.local/state /home/runner/.cache/opencode /home/runner/.config/opencode /home/runner/workspace 2>/dev/null || true
chown -R runner:runner /home/runner/.local /home/runner/.cache /home/runner/.config /home/runner/workspace /root 2>/dev/null || true
find /home/runner/workspace -mindepth 1 -maxdepth 1 -name lost+found -type d -exec rm -rf {} + 2>/dev/null || true
# Global config (share, permission, MCP servers) is handed in at runtime rather
# than baked into the image because it carries credentials. Written as the
# global config file, not OPENCODE_CONFIG_CONTENT, so project configs still
# override it. The control plane sets it from NORTHFLANK_VM_GLOBAL_CONFIG.
if [ -n "$OPENCODE_GLOBAL_CONFIG" ]; then
  printf '%s\n' "$OPENCODE_GLOBAL_CONFIG" > /home/runner/.config/opencode/opencode.jsonc
  chown runner:runner /home/runner/.config/opencode/opencode.jsonc 2>/dev/null || true
  chmod 600 /home/runner/.config/opencode/opencode.jsonc
fi
unset OPENCODE_GLOBAL_CONFIG
su runner -c "git config --global --add safe.directory '*'" 2>/dev/null || true
if [ -n "$OPENCODE_PROJECT_NAME" ]; then
  printf "export PS1='runner@%s:\w\$ '\n" "$OPENCODE_PROJECT_NAME" > /etc/profile.d/omai-prompt.sh
  printf "export PS1='runner@%s:\w\$ '\n" "$OPENCODE_PROJECT_NAME" >> /home/runner/.bashrc
  chown runner:runner /home/runner/.bashrc /etc/profile.d/omai-prompt.sh 2>/dev/null || true
  chmod 644 /etc/profile.d/omai-prompt.sh
  hostname "$OPENCODE_PROJECT_NAME" 2>/dev/null || true
fi
exec runuser -u runner -- env HOME=/home/runner omai serve --hostname 0.0.0.0 --cors "http://${OPENCODE_HOST}" --cors "http://${OPENCODE_HOST}:${OPENCODE_FRONTEND_PORT}" --cors "https://${OPENCODE_HOST}" --cors "https://${OPENCODE_HOST}:${OPENCODE_FRONTEND_PORT}" --port ${OPENCODE_SERVER_PORT}
ENTRYPOINT
RUN chmod +x /usr/local/bin/entrypoint.sh

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
